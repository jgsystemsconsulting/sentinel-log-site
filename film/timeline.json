 "captions": [
  {
   "id": "L01",
   "t0": 0.5,
   "text": "Hazard records live in spreadsheets, shared drives and email threads."
  },
  {
   "id": "L02",
   "t0": 6.68,
   "text": "The golden thread is lost."
  },
  {
   "id": "L03",
   "t0": 10.12,
   "text": "One system holds every hazard in place."
  },
  {
   "id": "L04",
   "t0": 14.59,
   "text": "Cause. Consequence. Control. Evidence. Residual risk. Linked end to end."
  },
  {
   "id": "L05",
   "t0": 21.87,
   "text": "A living register with a full audit trail, baselines and configurable risk matrices."
  },
  {
   "id": "L06",
   "t0": 29.5,
   "text": "Senior leaders see the whole programme on a single page."
  },
  {
   "id": "L07",
   "t0": 34.64,
   "text": "Self-hosted. Open source. On-prem or air-gapped. No lock-in."
  },
  {
   "id": "L08",
   "t0": 40.86,
   "text": "Sentinel Log. Every hazard. Every control. Every piece of evidence. One golden thread."
  }
